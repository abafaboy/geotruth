+  /**
+   * Tests whether a point lies within the tolerance distance of another point.
+   * Squared distances are not used, since the squares of distances and
+   * tolerances above about 1.3e154 overflow to infinity, and those below
+   * about 1.5e-162 underflow to zero.
+   */
+  private boolean isWithinTolerance(Coordinate p, Coordinate q) {
+    double dx = Math.abs(p.x - q.x);
+    double dy = Math.abs(p.y - q.y);
+    // cheap rejection; also rejects every distinct point when tolerance is 0
+    if (dx > tolerance || dy > tolerance)
+      return false;
+    return Math.hypot(dx, dy) <= tolerance;
+  }
