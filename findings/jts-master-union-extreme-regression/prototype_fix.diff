+  /**
+   * The square of a tolerance above about 1.3e154 overflows to infinity:
+   * distinct points must still not be snapped together.
+   */
+  public void testLargeToleranceDoesNotSnapDistantPoints() {
+    KdTree index = new KdTree(1e155);
+    KdNode node1 = index.insert(new Coordinate(0, 0));
+    KdNode node2 = index.insert(new Coordinate(1e300, 0));
+    assertTrue(node1 != node2);
+    assertEquals(2, index.size());
+  }
+
+  /**
