+/* private */
+void
+TopologyComputer::evaluateNodeSingle(NodeSections* nodeSections, bool isA)
+{
+    //-- a node where polygons of one GC meet, not on the other geometry:
+    //-- its location in the other geometry is constant around the node
+    const CoordinateXY* p = nodeSections->getCoordinate();
+    RelateGeometry& geomO = isA ? geomB : geomA;
+    int locDimO = geomO.locateWithDim(p);
+    Location locO = DimensionLocation::location(locDimO);
+    if (locO == Location::BOUNDARY) return;
+    if (locO == Location::INTERIOR && DimensionLocation::dimension(locDimO) != Dimension::A) return;
+    std::unique_ptr<RelateNode> node = nodeSections->createNode();
+    RelateGeometry& geomG = isA ? geomA : geomB;
+    bool isAreaInterior = geomG.isNodeInArea(p, nodeSections->getPolygonal(isA));
+    node->finishNode(isA, isAreaInterior);
+    for (const std::unique_ptr<RelateEdge>& e : node->getEdges()) {
+        updateDim(isA, e->location(isA, Position::LEFT), locO, Dimension::A);
+        updateDim(isA, e->location(isA, Position::RIGHT), locO, Dimension::A);
+        updateDim(isA, e->location(isA, Position::ON), locO, Dimension::L);
+    }
+}
