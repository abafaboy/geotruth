+  /**
+   * Evaluates a node where polygons of one GeometryCollection meet
+   * but the other geometry has no edge.
+   * The union boundary there may belong to no input ring
+   * (e.g. a hole formed by several overlapping polygons),
+   * so it is seen nowhere else.
+   * The node's location in the other geometry is constant around the node.
+   */
+  private void evaluateCollectionNode(NodeSections nodeSections) {
+    Coordinate p = nodeSections.getCoordinate();
+    boolean isA = nodeSections.isA();
+    RelateGeometry geom = isA ? geomA : geomB;
+    RelateGeometry geomOther = isA ? geomB : geomA;
+    int locDimOther = geomOther.locateWithDim(p);
+    int locOther = DimensionLocation.location(locDimOther);
+    if (locOther == Location.BOUNDARY)
+      return;
+    if (locOther == Location.INTERIOR && DimensionLocation.dimension(locDimOther) != Dimension.A)
+      return;
+    RelateNode node = nodeSections.createNode();
+    boolean isAreaInterior = geom.isNodeInArea(p, nodeSections.getPolygonal(isA));
+    node.finishNode(isA, isAreaInterior);
+    for (RelateEdge e : node.getEdges()) {
+      updateDim(isA, e.location(isA, Position.LEFT), locOther, Dimension.A);
+      updateDim(isA, e.location(isA, Position.RIGHT), locOther, Dimension.A);
+      updateDim(isA, e.location(isA, Position.ON), locOther, Dimension.L);
     }
   }
 
