+/* private */
+void
+TopologyComputer::evaluateCollectionNode(NodeSections* nodeSections)
+{
+    /**
+     * A node where polygons of one GeometryCollection meet, but the other
+     * geometry has no edge. The union boundary there may belong to no input
+     * ring (e.g. a hole formed by several overlapping polygons), so it is seen
+     * nowhere else. The node's location in the other geometry is constant
+     * around the node.
+     */
+    const CoordinateXY* p = nodeSections->getCoordinate();
+    bool isA = nodeSections->isA();
+    RelateGeometry& geom = getGeometry(isA);
+    RelateGeometry& geomOther = getGeometry(! isA);
+    int locDimOther = geomOther.locateWithDim(p);
+    Location locOther = DimensionLocation::location(locDimOther);
+    if (locOther == Location::BOUNDARY)
+        return;
+    if (locOther == Location::INTERIOR && DimensionLocation::dimension(locDimOther) != Dimension::A)
+        return;
+    std::unique_ptr<RelateNode> node = nodeSections->createNode();
+    bool isAreaInterior = geom.isNodeInArea(p, nodeSections->getPolygonal(isA));
+    node->finishNode(isA, isAreaInterior);
+    for (const std::unique_ptr<RelateEdge>& e : node->getEdges()) {
+        updateDim(isA, e->location(isA, Position::LEFT), locOther, Dimension::A);
+        updateDim(isA, e->location(isA, Position::RIGHT), locOther, Dimension::A);
+        updateDim(isA, e->location(isA, Position::ON), locOther, Dimension::L);
+    }
+}
