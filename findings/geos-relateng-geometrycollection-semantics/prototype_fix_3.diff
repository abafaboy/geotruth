+/* public */
+bool
+NodeSections::hasAreaSectionsOfSeveralElements() const
+{
+    if (sections.size() < 2)
+        return false;
+    const NodeSection* first = sections[0].get();
+    bool isSeveral = false;
+    for (const std::unique_ptr<NodeSection>& ns : sections) {
+        if (ns->isA() != first->isA() || ! ns->isArea())
+            return false;
+        if (ns->id() != first->id())
+            isSeveral = true;
+    }
+    return isSeveral;
+}
+
+
+/* public */
+bool
+NodeSections::isA() const
+{
+    return sections[0]->isA();
+}
