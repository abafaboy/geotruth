+    // PROTOTYPE: if the coordinate differences are tiny (or huge), their products
+    // underflow (or overflow) and neither the filter nor DD is exact any more.
+    // The sign of the determinant does not change when all x values and all
+    // y values are each multiplied by a power of two, so rescale x and y
+    // separately to bring the differences to about 1 (exact when scaling up;
+    // scaling down can round away bits of ordinates ~2^-1000 times smaller).
+    {
+        double mx = std::max(std::abs(p2x - p1x), std::abs(qx - p2x));
+        double my = std::max(std::abs(p2y - p1y), std::abs(qy - p2y));
+        auto out = [](double m) { return m > 0 && std::isfinite(m) && (m < 0x1p-400 || m > 0x1p400); };
+        if (out(mx) || out(my)) {
+            int ex = out(mx) ? -std::ilogb(mx) : 0;
+            int ey = out(my) ? -std::ilogb(my) : 0;
+            return orientationIndex(std::ldexp(p1x, ex), std::ldexp(p1y, ey),
+                                    std::ldexp(p2x, ex), std::ldexp(p2y, ey),
+                                    std::ldexp(qx, ex), std::ldexp(qy, ey));
+        }
+    }
